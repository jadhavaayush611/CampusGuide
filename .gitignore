# =============================================================================
# CampusGuide - Shared Repository .gitignore
# =============================================================================

# Backend (Java / Spring Boot / Maven)
target/
backend/target/
backend/bin/
backend/build/
*.class
*.jar
*.war
*.ear
*.log
*.log.*
backend/.mvn/wrapper/maven-wrapper.jar

# Frontend (Node / Vite / React)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
frontend/coverage/
frontend/*.local
frontend/.eslintcache

# Portable IDE & Editor Configuration
# Shared configs in .idea/ and .vscode/ are committed. Ignore only user/machine state.
.idea/**/workspace.xml
.idea/**/usage.statistics.xml
.idea/**/tasks.xml
.idea/**/shelf/
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/**/httpRequests/
.idea/**/dictionaries/
backend/.idea/**/workspace.xml
.vscode/*.log
.vscode/.react*
*.swp
*.swo
*~
.classpath
backend/.classpath
.project
backend/.project
.settings/
backend/.settings/

# Operating System Artifacts
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
*.env
*.pem
*.key
*.p12

# Runtime Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary Files & Local Data
*.tmp
*.temp
.cache/
mongodb_data/
uploads/
backend/uploads/

# Agent Internal Runtime Metadata
# Shared skills, prompts, workflows, and instructions in .agents/ are committed.
.agents/cache/
.agents/logs/
.agents/tmp/
.agents/runtime/